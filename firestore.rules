rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidCategory(cat) {
      return cat in ['FOCUS', 'HEALTH', 'WELLNESS', 'LEARNING', 'PERSONAL', 'REST'];
    }

    function isValidUserProfile(data, expectedUserId) {
      return data.userId is string &&
             data.userId == expectedUserId &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.themeMode in ['SYSTEM', 'LIGHT', 'DARK'] &&
             data.morningStartMinute is int &&
             data.morningStartMinute >= 0 &&
             data.morningStartMinute <= 1439 &&
             data.dayEndMinute is int &&
             data.dayEndMinute > data.morningStartMinute &&
             data.dayEndMinute <= 1440 &&
             data.defaultBufferMinutes is int &&
             data.defaultBufferMinutes >= 0 &&
             data.defaultBufferMinutes <= 60 &&
             data.notificationsEnabled is bool &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidActivity(data, expectedUserId) {
      return data.userId is string &&
             data.userId == expectedUserId &&
             data.userId.size() <= 128 &&
             isValidDateKey(data.dateKey) &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.description is string &&
             data.description.size() <= 500 &&
             isValidCategory(data.category) &&
             data.startMinute is int &&
             data.startMinute >= 0 &&
             data.startMinute <= 1439 &&
             data.endMinute is int &&
             data.endMinute > data.startMinute &&
             data.endMinute <= 1440 &&
             data.sortOrder is int &&
             data.sortOrder >= 0 &&
             data.sortOrder <= 10000 &&
             data.completed is bool &&
             data.flexible is bool &&
             data.reminderEnabled is bool &&
             data.reminderMinutesBefore is int &&
             data.reminderMinutesBefore >= 0 &&
             data.reminderMinutesBefore <= 120 &&
             data.status in ['SCHEDULED', 'DELAYED', 'RESCHEDULED', 'COMPLETED'] &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidHabit(data, expectedUserId) {
      return data.userId is string &&
             data.userId == expectedUserId &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 80 &&
             isValidCategory(data.category) &&
             data.targetDaysPerWeek is int &&
             data.targetDaysPerWeek >= 1 &&
             data.targetDaysPerWeek <= 7 &&
             data.reminderTimeMinute is int &&
             data.reminderTimeMinute >= 0 &&
             data.reminderTimeMinute <= 1439 &&
             data.completedDates is list &&
             data.completedDates.size() <= 500 &&
             (data.completedDates.size() == 0 || data.completedDates[0] is string) &&
             isValidDateKey(data.createdDateKey) &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'themeMode',
                         'morningStartMinute', 'dayEndMinute',
                         'defaultBufferMinutes', 'notificationsEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'photoUrl', 'themeMode',
                         'morningStartMinute', 'dayEndMinute',
                         'defaultBufferMinutes', 'notificationsEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'photoUrl', 'themeMode',
                         'morningStartMinute', 'dayEndMinute',
                         'defaultBufferMinutes', 'notificationsEnabled',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /activities/{activityId} {
        allow get: if isOwner(userId) && isValidId(activityId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(activityId) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'title', 'description', 'category',
                           'startMinute', 'endMinute', 'sortOrder', 'completed',
                           'flexible', 'reminderEnabled', 'reminderMinutesBefore',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'title', 'description', 'category',
                           'startMinute', 'endMinute', 'sortOrder', 'completed',
                           'flexible', 'reminderEnabled', 'reminderMinutesBefore',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidActivity(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(activityId) &&
                         isValidActivity(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'dateKey', 'title', 'description', 'category',
                           'startMinute', 'endMinute', 'sortOrder', 'completed',
                           'flexible', 'reminderEnabled', 'reminderMinutesBefore',
                           'status', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(activityId);
      }

      match /habits/{habitId} {
        allow get: if isOwner(userId) && isValidId(habitId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(habitId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'category', 'targetDaysPerWeek',
                           'reminderTimeMinute', 'completedDates', 'createdDateKey',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'category', 'targetDaysPerWeek',
                           'reminderTimeMinute', 'completedDates', 'createdDateKey',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidHabit(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(habitId) &&
                         isValidHabit(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().createdDateKey == existing().createdDateKey &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'category', 'targetDaysPerWeek',
                           'reminderTimeMinute', 'completedDates', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(habitId);
      }
    }
  }
}
